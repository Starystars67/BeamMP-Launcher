<Project Sdk="Microsoft.NET.Sdk">
  <!-- The parts of the plugin that do not need the game, checked without the game. `dotnet run` exits 1 on a failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../plugin/Wire.cs" />
    <Compile Include="../../plugin/Room.cs" />
    <Compile Include="../../plugin/Policy.cs" />
    <Compile Include="../../plugin/Replay.cs" />
    <Compile Include="../../plugin/PlayerState.cs" />
    <Compile Include="../../plugin/PhysicsState.cs" />
    <Compile Include="../../plugin/Ownership.cs" />
    <Compile Include="../../plugin/InboundGate.cs" />
  </ItemGroup>
</Project>
